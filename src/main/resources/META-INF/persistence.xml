<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">
    <persistence-unit name="tarjetasPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Lista de entidades -->
        <class>org.example.model.Cotizacion</class>
        <class>org.example.model.Tarjeta</class>
        <class>org.example.model.Consumo</class>
        <class>org.example.model.Liquidacion</class>

        <properties>
            <!-- JDBC -->
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <!--property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:tarjetas;DB_CLOSE_DELAY=-1"/>

            <!- para que persistan las tablas y sean guardadas en un archivo para consultas luego -->
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:file:./data/tarjetas;DB_CLOSE_DELAY=-1"/>


            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>

            <!-- MUY IMPORTANTE: Forzar el dialecto en Hibernate 6 -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>

            <!-- Gestión de Esquema: Solo 'update' o 'create'. Elimina las de script. -->
            <!--property name="hibernate.hbm2ddl.auto" value="create-drop"/  -->
            <!-- crea las tablas sino existen , o las actualiza si estan  -->
            <!--property name="hibernate.hbm2ddl.auto" value="update"/-->
            <property name="hibernate.hbm2ddl.auto" value="none"/>


            <!-- Logs (para depuración si falla de nuevo) -->
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.highlight_sql" value="true"/>

            <!-- Elimina cualquier propiedad que empiece con 'jakarta.persistence.schema-generation' -->
            <!-- Elimina 'logging.level' ya que es propiedad de Logback/SLF4J, no de Hibernate Persistence -->
        </properties>
    </persistence-unit>
</persistence>